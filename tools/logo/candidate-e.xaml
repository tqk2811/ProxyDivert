<!-- E. Lăng kính: một chùm đi vào, ra thành ba tia lệch hướng.
     Nền tối, mark teal — nổi trên thanh tác vụ sáng. -->
<DrawingImage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <DrawingImage.Drawing>
        <DrawingGroup>

            <GeometryDrawing>
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#16323C"/>
                        <GradientStop Offset="1" Color="#08161C"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,256,256" RadiusX="56" RadiusY="56"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <!-- Chùm đi vào, dừng ngay trước mặt trái của lăng kính. -->
            <GeometryDrawing Geometry="M 14,144 L 50,144">
                <GeometryDrawing.Pen>
                    <Pen Brush="#EAFFFB" Thickness="16" StartLineCap="Round" EndLineCap="Flat"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>

            <!-- Ba tia đi ra, toả từ một điểm nằm ngoài mặt phải, lệch dần và nhạt dần. -->
            <GeometryDrawing Geometry="M 156,144 L 238,96">
                <GeometryDrawing.Pen>
                    <Pen Brush="#2FD9C6" Thickness="14" StartLineCap="Flat" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 158,144 L 242,144">
                <GeometryDrawing.Pen>
                    <Pen Brush="#B32FD9C6" Thickness="14" StartLineCap="Flat" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 156,144 L 238,192">
                <GeometryDrawing.Pen>
                    <Pen Brush="#732FD9C6" Thickness="14" StartLineCap="Flat" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>

            <!-- Lăng kính, vẽ sau cùng nên nó che chỗ các tia bắt đầu. -->
            <GeometryDrawing Geometry="M 102,58 L 160,182 L 44,182 Z">
                <GeometryDrawing.Pen>
                    <Pen Brush="#EAFFFB" Thickness="20" LineJoin="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>

        </DrawingGroup>
    </DrawingImage.Drawing>
</DrawingImage>
