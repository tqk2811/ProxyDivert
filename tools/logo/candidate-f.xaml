<!-- F. Nút mạng: một tiến trình ở giữa, ba đường ra ba outbound — đường đang dùng thì đậm.
     Nền sáng, mark teal — nổi trên thanh tác vụ tối. -->
<DrawingImage xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <DrawingImage.Drawing>
        <DrawingGroup>

            <GeometryDrawing>
                <GeometryDrawing.Brush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Offset="0" Color="#FFFFFF"/>
                        <GradientStop Offset="1" Color="#D8F0ED"/>
                    </LinearGradientBrush>
                </GeometryDrawing.Brush>
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="0,0,256,256" RadiusX="56" RadiusY="56"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <!-- Hai lối không dùng. -->
            <GeometryDrawing Geometry="M 100,128 L 176,68">
                <GeometryDrawing.Pen>
                    <Pen Brush="#5912A899" Thickness="20" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
            <GeometryDrawing Geometry="M 100,128 L 176,188">
                <GeometryDrawing.Pen>
                    <Pen Brush="#5912A899" Thickness="20" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>

            <!-- Lối đang dùng. -->
            <GeometryDrawing Geometry="M 100,128 L 182,128">
                <GeometryDrawing.Pen>
                    <Pen Brush="#0E9184" Thickness="24" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>

            <!-- Ba đích. -->
            <GeometryDrawing Brush="#5912A899">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <EllipseGeometry Center="190,62" RadiusX="20" RadiusY="20"/>
                        <EllipseGeometry Center="190,194" RadiusX="20" RadiusY="20"/>
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
            <GeometryDrawing Brush="#0E9184">
                <GeometryDrawing.Geometry>
                    <EllipseGeometry Center="196,128" RadiusX="24" RadiusY="24"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

            <!-- Tiến trình. -->
            <GeometryDrawing Brush="#0E9184">
                <GeometryDrawing.Geometry>
                    <RectangleGeometry Rect="36,92,72,72" RadiusX="22" RadiusY="22"/>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>

        </DrawingGroup>
    </DrawingImage.Drawing>
</DrawingImage>
