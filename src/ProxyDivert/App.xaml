<Application x:Class="ProxyDivert.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!-- Only the strings live here for the whole run: the tray menu, the tooltip and the view
         models read them with no window open. Everything else the window needs is in
         Themes/UiResources.xaml, merged by code only while the window exists (UiResources.Load),
         so the process sitting in the tray stays small. -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Localization/Strings.en.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
