<UserControl x:Class="ProxyDivert.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Two columns, cards grouped by what they are about: how traffic is caught and carried
             on the left, how the app itself is reached, logged and shown on the right. -->
        <Grid Margin="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="380"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="380"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Column="0">

                <!-- ==== secure DNS ==== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.SecureDns}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.SecureDnsHint}"/>
                        <!-- Free text with suggestions: picking one writes its URL (TextPath) into the
                             box, while the list shows who runs it. -->
                        <DockPanel>
                            <TextBlock Text="{DynamicResource Str.Settings.DohEndpoint}" VerticalAlignment="Center" MinWidth="120"/>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="False" TextSearch.TextPath="Url"
                                      ItemsSource="{Binding DohEndpointPresets}"
                                      Text="{Binding DohEndpoint, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Provider}" MinWidth="70" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Url}" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- ==== process detection ====

                     Locked while redirection is on: swapping the source under a running engine leaves
                     a window where neither the old nor the new one is delivering, and a process that
                     starts inside it is redirected late or not at all. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel IsEnabled="{Binding IsEngineRunning, Converter={StaticResource InverseBool}}">
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.EventSource}"
                                   Margin="0,0,0,4"/>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,8" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.EventSourceHint}"/>

                        <RadioButton GroupName="ProcessDetection" Margin="0,0,0,4"
                                     Content="{DynamicResource Str.Settings.DetectionProcessEvents}"
                                     ToolTipService.ShowDuration="30000"
                                     ToolTip="{DynamicResource Str.Settings.DetectionProcessEventsTip}"
                                     IsChecked="{Binding UsesProcessEvents}"/>

                        <!-- Indented because they are a choice INSIDE the one above, and dimmed while
                             the other mode is picked: sniffing needs no process events at all, so the
                             question of which one to use stops applying rather than changing answer. -->
                        <StackPanel Margin="26,0,0,6" IsEnabled="{Binding UsesProcessEvents}">
                            <RadioButton GroupName="ProcessEventSource" Margin="0,0,0,4"
                                         Content="{DynamicResource Str.Settings.EventSourceEtw}"
                                         ToolTipService.ShowDuration="30000"
                                         ToolTip="{DynamicResource Str.Settings.EventSourceEtwTip}"
                                         IsChecked="{Binding UsesEtw}"/>
                            <RadioButton GroupName="ProcessEventSource"
                                         Content="{DynamicResource Str.Settings.EventSourceWmi}"
                                         ToolTipService.ShowDuration="30000"
                                         ToolTip="{DynamicResource Str.Settings.EventSourceWmiTip}"
                                         IsChecked="{Binding UsesWmi}"/>
                        </StackPanel>

                        <RadioButton GroupName="ProcessDetection"
                                     Content="{DynamicResource Str.Settings.DetectionNetworkSniff}"
                                     ToolTipService.ShowDuration="30000"
                                     ToolTip="{DynamicResource Str.Settings.DetectionNetworkSniffTip}"
                                     IsChecked="{Binding UsesNetworkSniff}"/>
                    </StackPanel>
                </Border>

                <!-- ==== network ==== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.NetworkGroup}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{DynamicResource Str.Settings.Ipv6}" VerticalAlignment="Center" MinWidth="120"/>
                            <ComboBox ItemsSource="{Binding Ipv6Modes}" SelectedItem="{Binding Ipv6}" Width="200"
                                      ItemTemplate="{StaticResource EnumItemTemplate}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,10" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.Ipv6Hint}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.Settings.CpuPriority}" VerticalAlignment="Center"
                                       MinWidth="120"/>
                            <ComboBox ItemsSource="{Binding CpuPriorities}" SelectedItem="{Binding CpuPriority}"
                                      Width="140" ItemTemplate="{StaticResource EnumItemTemplate}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.CpuPriorityHint}"/>
                    </StackPanel>
                </Border>

                <!-- ==== VPN helpers ==== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.VpnGroup}"
                                   Margin="0,0,0,8"/>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.Settings.WireProxy}" VerticalAlignment="Center" MinWidth="120"/>
                            <Button DockPanel.Dock="Right" Content="…" Command="{Binding BrowseWireProxyCommand}"
                                    Margin="8,0,0,0" MinWidth="36"/>
                            <TextBox Text="{Binding WireProxyPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Subtle}" Margin="0,0,0,10" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.WireProxyHint}"/>

                        <!-- No path box for this one: the blob has a fixed name and two places it may
                             live, so what the user needs is the button and the answer to "is it here". -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{DynamicResource Str.Settings.Watermark}" VerticalAlignment="Center" MinWidth="120"/>
                            <Button Content="{DynamicResource Str.Settings.WatermarkFetch}"
                                    Command="{Binding FetchWatermarkCommand}" MinWidth="90"/>
                            <TextBlock Text="{Binding WatermarkStatus}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       TextWrapping="Wrap" Style="{StaticResource Subtle}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.WatermarkHint}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2">

                <!-- ==== local API & MCP ====
                     Hidden in the lite build, which has no local API compiled in. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                        Visibility="{Binding IsLocalApiAvailable, Converter={StaticResource TrueToVisible}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.LocalApiGroup}"
                                   Margin="0,0,0,8"/>
                        <!-- Port and LAN lock while the API is on: the address a tool is talking to
                             must not move under it. The token applies at once, no restart. -->
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox Content="{DynamicResource Str.Settings.LocalApi}" Margin="0,0,16,4"
                                      IsChecked="{Binding LocalApiEnabled}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                <TextBlock Text="{DynamicResource Str.Settings.LocalApiPort}" Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <TextBox Text="{Binding LocalApiPort, UpdateSourceTrigger=PropertyChanged}" Width="70"
                                         IsEnabled="{Binding CanEditLocalApiAddress}"/>
                            </StackPanel>
                            <CheckBox Content="{DynamicResource Str.Settings.LocalApiLan}" Margin="0,0,16,4"
                                      IsChecked="{Binding LocalApiListenOnLan}" VerticalAlignment="Center"
                                      IsEnabled="{Binding CanEditLocalApiAddress}"/>
                            <Button Content="{DynamicResource Str.Settings.LocalApiOpenSwagger}" Margin="0,0,0,4"
                                    Command="{Binding OpenLocalApiSwaggerCommand}" MinWidth="90"
                                    IsEnabled="{Binding LocalApiEnabled}"/>
                        </WrapPanel>
                        <CheckBox Content="{DynamicResource Str.Settings.LocalApiRequireToken}" Margin="0,0,0,4"
                                  IsChecked="{Binding LocalApiRequireToken}"/>
                        <DockPanel Margin="0,0,0,8">
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Settings.LocalApiRegenerateToken}"
                                    Margin="8,0,0,0" Command="{Binding RegenerateLocalApiTokenCommand}" MinWidth="80"/>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource Str.Settings.LocalApiCopyToken}"
                                    Margin="8,0,0,0" Command="{Binding CopyLocalApiTokenCommand}" MinWidth="60"/>
                            <TextBox Text="{Binding LocalApiToken, Mode=OneWay}" IsReadOnly="True"/>
                        </DockPanel>
                        <CheckBox Content="{DynamicResource Str.Settings.LocalApiMcp}" Margin="0,0,0,4"
                                  IsChecked="{Binding LocalApiMcpEnabled}" IsEnabled="{Binding LocalApiEnabled}"
                                  ToolTip="{DynamicResource Str.Settings.LocalApiMcpHint}"/>
                        <TextBlock Foreground="{DynamicResource Brush.Danger}" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="{Binding LocalApiError}" Visibility="{Binding HasLocalApiError, Converter={StaticResource TrueToVisible}}"/>
                        <TextBlock Foreground="{DynamicResource Brush.Warning}" Margin="0,0,0,4" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.LocalApiLanWarning}"
                                   Visibility="{Binding LocalApiLanWithoutToken, Converter={StaticResource TrueToVisible}}"/>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.LocalApiHint}"/>
                    </StackPanel>
                </Border>

                <!-- ==== logging ====
                     The level and the folder sit on the switch's own line: they are what the
                     user reaches for in the same breath as ticking it, and the level filters
                     the file only — the log pane keeps showing everything. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.LogGroup}"
                                   Margin="0,0,0,8"/>
                        <WrapPanel Margin="0,0,0,4">
                            <CheckBox Content="{DynamicResource Str.Settings.AutoSaveLog}" Margin="0,0,16,4"
                                      IsChecked="{Binding AutoSaveLog}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{DynamicResource Str.Settings.FileLogLevel}" Margin="0,0,6,0"
                                           VerticalAlignment="Center"/>
                                <ComboBox ItemsSource="{Binding FileLogLevels}" SelectedItem="{Binding FileLogLevel}"
                                          Width="140" ItemTemplate="{StaticResource EnumItemTemplate}"/>
                                <Button Content="{DynamicResource Str.Settings.OpenLogFolder}"
                                        Command="{Binding OpenLogFolderCommand}" Margin="8,0,0,0" MinWidth="110"/>
                            </StackPanel>
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                                   Text="{DynamicResource Str.Settings.AutoSaveLogHint}"/>
                    </StackPanel>
                </Border>

                <!-- ==== appearance ==== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="{DynamicResource Str.Settings.Appearance}"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str.Settings.Language}" VerticalAlignment="Center" MinWidth="120"/>
                            <!-- Its own converter, not the enum one: a language is named in its own
                                 language, so the list stays readable whichever one is active. -->
                            <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="200"
                                      ItemTemplate="{StaticResource LanguageItemTemplate}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str.Settings.Theme}" VerticalAlignment="Center" MinWidth="120"/>
                            <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="200"
                                      ItemTemplate="{StaticResource EnumItemTemplate}"/>
                        </StackPanel>
                        <CheckBox Content="{DynamicResource Str.Settings.StartWithWindows}"
                                  IsChecked="{Binding StartWithWindows}"/>
                        <CheckBox Content="{DynamicResource Str.Settings.MinimizeToTrayOnClose}"
                                  IsChecked="{Binding MinimizeToTrayOnClose}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="1" Grid.ColumnSpan="3">
                <TextBlock Style="{StaticResource Subtle}" TextWrapping="Wrap"
                           Text="{DynamicResource Str.Settings.RestartHint}"/>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,12,0,0" TextWrapping="Wrap"
                           Text="{DynamicResource Str.Warn.AntiCheat}"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
