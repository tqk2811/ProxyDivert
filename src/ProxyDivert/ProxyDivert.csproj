<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RootNamespace>ProxyDivert</RootNamespace>
		<AssemblyName>ProxyDivert</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Sinh lại bằng tools/logo/Generate-AppIcon.ps1 từ Themes/Logo.xaml; file .ico được commit
		     nên bản build không cần chạy script. -->
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<!-- Native WinDivert chỉ có win-x64; cần RID để asset runtimes/win-x64/native được copy ra output. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- Cũng nhúng làm Resource, không chỉ làm icon của exe: cửa sổ và icon khay đọc nó qua
		     pack URI, và thư viện khay đòi đúng một file .ico chứ không nhận vector. -->
		<Resource Include="Assets\app.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- Khối watermark của SoftEther là dữ liệu GPL nên không thể đóng gói kèm; thứ đi cùng exe
		     là script tải nó về từ nguồn chính thức, để người dùng chạy được ngay cạnh chỗ cài mà
		     không phải đi tìm repo. -->
		<None Include="..\..\tools\Get-SoftEtherWatermark.ps1" Link="Get-SoftEtherWatermark.ps1"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ProxyDivert.Core\ProxyDivert.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Cùng lý do như ở Core: vài thứ chỉ kiểm được bằng test nhưng không nên public trên
		     ViewModel (vd hàm dựng cây tiến trình đang áp dụng). -->
		<InternalsVisibleTo Include="ProxyDivert.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Native.WinDivert" />
	</ItemGroup>

	<!--
		Phiên bản lấy từ git: <Major>.<Minor> theo tag vM.N.x gần nhất, số thứ ba đếm các commit có
		"[release]" trong message kể từ tag (gồm cả commit gắn tag), bắt đầu từ 0: commit [release] đầu
		tiên tính từ tag v1.2.0 là 1.2.0, cái thứ hai là 1.2.1. Commit thường mang số của bản [release] gần nhất trước nó (chưa có
		bản nào thì .0). Chưa có tag nào thì 0.0.<...>, đếm từ đầu repo.
		Cố ý không dùng GitVersion.MsBuild: nó báo "orphaned branch" và làm đỏ build trên nhánh phụ,
		còn git chạy được ở mọi nhánh. Không có git (vd build từ source zip) thì giữ 1.0.0.
	-->
	<Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion">
		<Exec Command="git describe --tags --abbrev=0 --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" EchoOff="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitTag" />
			<Output TaskParameter="ExitCode" PropertyName="_GitTagExit" />
		</Exec>
		<PropertyGroup>
			<_GitTag Condition="'$(_GitTagExit)' != '0'"></_GitTag>
			<_GitRange Condition="'$(_GitTag)' != ''">$(_GitTag.Trim())..HEAD</_GitRange>
			<_GitRange Condition="'$(_GitTag)' == ''">HEAD</_GitRange>
		</PropertyGroup>
		<Exec Command="git rev-list --count --fixed-strings --grep=&quot;[release]&quot; $(_GitRange)" WorkingDirectory="$(MSBuildProjectDirectory)"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" EchoOff="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitReleaseCount" />
			<Output TaskParameter="ExitCode" PropertyName="_GitCountExit" />
		</Exec>
		<!-- tag..HEAD không gồm chính commit gắn tag: nếu nó cũng có [release] thì nó là bản .0. -->
		<Exec Command="git rev-list --count --no-walk --fixed-strings --grep=&quot;[release]&quot; $(_GitTag.Trim())" WorkingDirectory="$(MSBuildProjectDirectory)"
		      Condition="'$(_GitTag)' != '' and '$(_GitCountExit)' == '0'"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" EchoOff="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitTagIsRelease" />
		</Exec>
		<PropertyGroup Condition="'$(_GitCountExit)' == '0' and '$(_GitTagIsRelease.Trim())' == '1'">
			<_GitReleaseCount>$([MSBuild]::Add($(_GitReleaseCount.Trim()), 1))</_GitReleaseCount>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_GitCountExit)' == '0'">
			<_GitMajorMinor Condition="'$(_GitTag)' != ''">$([System.Text.RegularExpressions.Regex]::Match('$(_GitTag.Trim())', '^v(\d+\.\d+)\.').Groups[1].Value)</_GitMajorMinor>
			<_GitMajorMinor Condition="'$(_GitMajorMinor)' == ''">0.0</_GitMajorMinor>
			<_GitPatch>0</_GitPatch>
			<_GitPatch Condition="$(_GitReleaseCount.Trim()) &gt; 0">$([MSBuild]::Subtract($(_GitReleaseCount.Trim()), 1))</_GitPatch>
			<Version>$(_GitMajorMinor).$(_GitPatch)</Version>
			<FileVersion>$(Version)</FileVersion>
			<InformationalVersion>$(Version)</InformationalVersion>
		</PropertyGroup>
		<Message Importance="high" Text="ProxyDivert version: $(Version)" />
	</Target>

</Project>
