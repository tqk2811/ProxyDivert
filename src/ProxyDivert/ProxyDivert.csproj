<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<UseWPF>true</UseWPF>
		<RootNamespace>ProxyDivert</RootNamespace>
		<AssemblyName>ProxyDivert</AssemblyName>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<!-- Sinh lại bằng tools/logo/Generate-AppIcon.ps1 từ Themes/Logo.xaml; file .ico được commit
		     nên bản build không cần chạy script. -->
		<ApplicationIcon>Assets\app.ico</ApplicationIcon>
		<!-- Native WinDivert chỉ có win-x64; cần RID để asset runtimes/win-x64/native được copy ra output. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<!-- Cũng nhúng làm Resource, không chỉ làm icon của exe: cửa sổ và icon khay đọc nó qua
		     pack URI, và thư viện khay đòi đúng một file .ico chứ không nhận vector. -->
		<Resource Include="Assets\app.ico" />
	</ItemGroup>

	<ItemGroup>
		<!-- Khối watermark của SoftEther là dữ liệu GPL nên không thể đóng gói kèm; thứ đi cùng exe
		     là script tải nó về từ nguồn chính thức, để người dùng chạy được ngay cạnh chỗ cài mà
		     không phải đi tìm repo. -->
		<None Include="..\..\tools\Get-SoftEtherWatermark.ps1" Link="Get-SoftEtherWatermark.ps1"
		      CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ProxyDivert.Core\ProxyDivert.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Cùng lý do như ở Core: vài thứ chỉ kiểm được bằng test nhưng không nên public trên
		     ViewModel (vd hàm dựng cây tiến trình đang áp dụng). -->
		<InternalsVisibleTo Include="ProxyDivert.Core.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="Hardcodet.NotifyIcon.Wpf" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Logging" />
		<PackageReference Include="Native.WinDivert" />
	</ItemGroup>

	<!--
		The local HTTP API (Api/), its Swagger page and the MCP server at /mcp run on a Kestrel inside
		this process. Compile-time option (EnableLocalApi, default true, set in src/Directory.Build.props
		together with the LOCAL_API constant): -p:EnableLocalApi=false builds the "lite" app without
		ASP.NET Core, so its framework-dependent build needs only the .NET Desktop Runtime. The wiring
		is under #if LOCAL_API; LocalApiSettings stays in Core either way so config files round-trip.
	-->
	<ItemGroup Condition="'$(EnableLocalApi)' == 'true'">
		<PackageReference Include="Swashbuckle.AspNetCore" />
		<PackageReference Include="ModelContextProtocol.AspNetCore" />
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup Condition="'$(EnableLocalApi)' != 'true'">
		<Compile Remove="Api\**" />
	</ItemGroup>

	<!--
		Phiên bản lấy từ tag git vM.N.P, gắn tay rồi push (push tag là thứ kích hoạt CI release):
		commit đang mang tag vM.N.P thì ra đúng M.N.P. Commit sau tag gần nhất (bản dev) giữ M.N.P,
		FileVersion thêm số thứ tư = số commit kể từ tag và InformationalVersion ghi "M.N.P-dev.<số>".
		Chưa có tag nào thì 0.0.0.
		Cố ý không dùng GitVersion.MsBuild: nó báo "orphaned branch" và làm đỏ build trên nhánh phụ,
		còn git chạy được ở mọi nhánh. Không có git (vd build từ source zip) thì giữ 1.0.0.
	-->
	<Target Name="SetVersionFromGit" BeforeTargets="GetAssemblyVersion">
		<Exec Command="git describe --tags --long --match &quot;v[0-9]*.[0-9]*.[0-9]*&quot;" WorkingDirectory="$(MSBuildProjectDirectory)"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" EchoOff="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="_GitDescribe" />
			<Output TaskParameter="ExitCode" PropertyName="_GitDescribeExit" />
		</Exec>
		<!-- Có git mà chưa có tag: describe báo lỗi, phân biệt với không có git bằng rev-parse. -->
		<Exec Command="git rev-parse HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" Condition="'$(_GitDescribeExit)' != '0'"
		      ConsoleToMSBuild="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" EchoOff="true">
			<Output TaskParameter="ExitCode" PropertyName="_GitRevParseExit" />
		</Exec>
		<PropertyGroup Condition="'$(_GitDescribeExit)' == '0'">
			<!-- "v1.2.3-5-gabcdef0": tag v1.2.3, 5 commit kể từ tag. -->
			<_GitVersion>$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribe.Trim())', '^v(\d+\.\d+\.\d+)-\d+-g').Groups[1].Value)</_GitVersion>
			<_GitDistance>$([System.Text.RegularExpressions.Regex]::Match('$(_GitDescribe.Trim())', '-(\d+)-g[0-9a-f]+$').Groups[1].Value)</_GitDistance>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_GitDescribeExit)' != '0' and '$(_GitRevParseExit)' == '0'">
			<_GitVersion>0.0.0</_GitVersion>
			<_GitDistance>0</_GitDistance>
		</PropertyGroup>
		<PropertyGroup Condition="'$(_GitVersion)' != '' and '$(_GitDistance)' != ''">
			<Version>$(_GitVersion)</Version>
			<FileVersion>$(_GitVersion).$(_GitDistance)</FileVersion>
			<InformationalVersion>$(_GitVersion)</InformationalVersion>
			<InformationalVersion Condition="'$(_GitDistance)' != '0'">$(_GitVersion)-dev.$(_GitDistance)</InformationalVersion>
		</PropertyGroup>
		<Warning Condition="'$(_GitDescribeExit)' == '0' and '$(_GitVersion)' == ''" Text="Tag gần nhất '$(_GitDescribe.Trim())' không phải dạng vM.N.P, version giữ mặc định." />
		<Message Importance="high" Text="ProxyDivert version: $(InformationalVersion)" />
	</Target>

</Project>
