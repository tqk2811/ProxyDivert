<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0-windows</TargetFramework>
		<RootNamespace>ProxyDivert.Core</RootNamespace>
		<AssemblyName>ProxyDivert.Core</AssemblyName>
		<Description>Engine, models và service của ProxyDivert (không phụ thuộc WPF).</Description>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\libs\TqkLibrary.WinDivert\src\TqkLibrary.WinDivert\TqkLibrary.WinDivert.csproj" />
		<ProjectReference Include="..\..\libs\TqkLibrary.Proxy\src\TqkLibrary.Proxy\TqkLibrary.Proxy.csproj" />
		<!-- VPN outbound: wireproxy runs the WireGuard tunnel in user space and exposes it as SOCKS5,
		     so no TUN adapter and no route-table surgery. -->
		<ProjectReference Include="..\..\libs\TqkLibrary.Proxy\src\TqkLibrary.Proxy.Vpn.WireProxyCli\TqkLibrary.Proxy.Vpn.WireProxyCli.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="System.Management" />
		<PackageReference Include="System.Security.Cryptography.ProtectedData" />
	</ItemGroup>

</Project>
