<Window x:Class="ProxyDivert.Wpf.Views.UnsavedChangesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Str.Process.UnsavedTitle}"
        SizeToContent="WidthAndHeight" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush.Window.Background}"
        TextElement.Foreground="{DynamicResource Brush.Text.Primary}">

    <!-- Three answers rather than the two a MessageBox would give here, and in the app's own words:
         the system dialog can only label them Yes/No/Cancel, in the language Windows is in, which
         is the wrong question in the wrong language on a machine set to English with the app in
         Vietnamese. -->
    <Border BorderThickness="1" BorderBrush="{DynamicResource Brush.Surface.BorderBrush}">
        <StackPanel Margin="22,20,22,18" MaxWidth="420">
            <TextBlock FontSize="15" FontWeight="SemiBold"
                       Text="{DynamicResource Str.Process.UnsavedTitle}"/>

            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Str.Process.UnsavedQuestion}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <!-- Cancel is the Esc key and the safe answer: it goes back to the editor with the
                     edit still in it. -->
                <Button MinWidth="96" IsCancel="True" Click="Cancel_Click"
                        Content="{DynamicResource Str.App.Cancel}"/>
                <Button MinWidth="96" Margin="8,0,0,0" Click="Discard_Click"
                        Content="{DynamicResource Str.App.DontSave}"/>
                <Button MinWidth="96" Margin="8,0,0,0" IsDefault="True" Click="Save_Click"
                        Style="{StaticResource AccentButton}"
                        Content="{DynamicResource Str.App.Save}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
