<UserControl x:Class="ProxyDivert.Wpf.Views.OutboundsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Margin="4">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                       Text="{DynamicResource Str.Tab.Outbounds}" Margin="0,0,0,4"/>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Subtle}"
                       Text="{DynamicResource Str.Outbound.Hint}" Margin="0,0,0,8" TextWrapping="Wrap"/>

            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="{DynamicResource Str.App.Add}" Command="{Binding AddCommand}" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Remove}" Command="{Binding RemoveCommand}"
                            Margin="8,0,0,0" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Test}" Command="{Binding TestCommand}"
                            Margin="8,0,0,0" MinWidth="80" IsEnabled="{Binding IsTesting, Converter={StaticResource InverseBool}}"/>
                    <Button Content="{DynamicResource Str.App.Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"/>
                </StackPanel>
                <TextBlock Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                           Text="{Binding TestResult}"/>
            </StackPanel>

            <DataGrid ItemsSource="{Binding Outbounds}" SelectedItem="{Binding Selected}"
                      AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="{DynamicResource Str.App.Enabled}"
                                            Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                    <DataGridTextColumn Header="{DynamicResource Str.App.Name}"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                    <DataGridComboBoxColumn Header="{DynamicResource Str.App.Type}"
                                            SelectedItemBinding="{Binding Kind, UpdateSourceTrigger=PropertyChanged}"
                                            ItemsSource="{Binding DataContext.Kinds,
                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            Width="110"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Outbound.Url}"
                                        Binding="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Outbound.Username}"
                                        Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Outbound.Password}"
                                        Binding="{Binding Password, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Border>
</UserControl>
