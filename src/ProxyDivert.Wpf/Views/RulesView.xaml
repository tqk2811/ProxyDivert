<UserControl x:Class="ProxyDivert.Wpf.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProxyDivert.Wpf.Bindings">
    <!-- A DataGrid column is outside the visual tree, so the combo columns below reach the view
         model through this proxy instead of an ancestor lookup that cannot resolve. -->
    <UserControl.Resources>
        <b:BindingProxy x:Key="Vm" Data="{Binding}"/>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==== policies ==== -->
        <Border Style="{StaticResource Card}" Grid.Column="0" Margin="0,0,4,0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Rules.Policies}" Margin="0,0,0,6"/>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Add}" Command="{Binding AddPolicyCommand}" MinWidth="70"/>
                    <Button Content="{DynamicResource Str.App.Remove}" Command="{Binding RemovePolicyCommand}"
                            Margin="8,0,0,0" MinWidth="70"/>
                </StackPanel>
                <ListBox ItemsSource="{Binding Policies}" SelectedItem="{Binding SelectedPolicy}"
                         DisplayMemberPath="Name"/>
            </DockPanel>
        </Border>

        <!-- ==== rules of the selected policy ==== -->
        <Border Style="{StaticResource Card}" Grid.Column="1">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Rules.Rules}" Margin="0,0,0,6"/>

                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{DynamicResource Str.App.Add}" Command="{Binding AddRuleCommand}" MinWidth="70"/>
                        <Button Content="{DynamicResource Str.App.Remove}" Command="{Binding RemoveRuleCommand}"
                                Margin="8,0,0,0" MinWidth="70"/>
                        <Button Content="{DynamicResource Str.App.Up}" Command="{Binding MoveUpCommand}"
                                Margin="8,0,0,0" MinWidth="60"/>
                        <Button Content="{DynamicResource Str.App.Down}" Command="{Binding MoveDownCommand}"
                                Margin="8,0,0,0" MinWidth="60"/>
                        <Button Content="{DynamicResource Str.App.Save}" Command="{Binding SaveCommand}"
                                Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="70"/>
                    </StackPanel>

                    <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.Rules.Default}" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding Outbounds}" DisplayMemberPath="Name" SelectedValuePath="Id"
                                  SelectedValue="{Binding SelectedPolicy.DefaultOutboundId}"
                                  Width="160" Margin="8,0,0,0"/>

                        <TextBlock Text="{DynamicResource Str.Rules.UdpMode}" VerticalAlignment="Center" Margin="20,0,0,0"/>
                        <ComboBox ItemsSource="{Binding UdpModes}" SelectedItem="{Binding SelectedPolicy.UdpMode}"
                                  ItemTemplate="{StaticResource EnumItemTemplate}"
                                  Width="150" Margin="8,0,0,0"/>

                        <CheckBox Content="{DynamicResource Str.Rules.BlockQuic}"
                                  IsChecked="{Binding SelectedPolicy.BlockQuic}"
                                  VerticalAlignment="Center" Margin="20,0,0,0"/>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource Subtle}" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="{DynamicResource Str.Rules.BlockQuicHint}"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{b:LocalizedBinding Str.App.Enabled}"
                                                Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridComboBoxColumn Header="{b:LocalizedBinding Str.App.Type}"
                                                SelectedItemBinding="{Binding Matcher, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding Data.Matchers, Source={StaticResource Vm}}"
                                                ElementStyle="{StaticResource EnumComboColumn}"
                                                EditingElementStyle="{StaticResource EnumComboColumn}"
                                                Width="120"/>
                        <DataGridTextColumn Header="{b:LocalizedBinding Str.App.Pattern}"
                                            Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridCheckBoxColumn Header="{b:LocalizedBinding Str.Rules.Not}"
                                                Binding="{Binding IsNot, UpdateSourceTrigger=PropertyChanged}" Width="55"/>
                        <DataGridComboBoxColumn Header="{b:LocalizedBinding Str.Rules.Outbound}"
                                                SelectedValueBinding="{Binding OutboundId, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="Id" DisplayMemberPath="Name"
                                                ItemsSource="{Binding Data.Outbounds, Source={StaticResource Vm}}"
                                                Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
