<UserControl x:Class="ProxyDivert.Wpf.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==== process rules ==== -->
        <Border Style="{StaticResource Card}" Grid.Row="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Process.Rules}" Margin="0,0,0,6"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Add}" Command="{Binding AddRuleCommand}" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Remove}" Command="{Binding RemoveRuleCommand}"
                            Margin="8,0,0,0" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{DynamicResource Str.App.Enabled}"
                                                Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridComboBoxColumn Header="{DynamicResource Str.App.Type}"
                                                SelectedItemBinding="{Binding Matcher, UpdateSourceTrigger=PropertyChanged}"
                                                ItemsSource="{Binding DataContext.Matchers,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                ElementStyle="{StaticResource EnumComboColumn}"
                                                EditingElementStyle="{StaticResource EnumComboColumn}"
                                                Width="110"/>
                        <DataGridTextColumn Header="{DynamicResource Str.App.Pattern}"
                                            Binding="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                        <DataGridCheckBoxColumn Header="{DynamicResource Str.Process.IncludeChildren}"
                                                Binding="{Binding IncludeChildren, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridComboBoxColumn Header="{DynamicResource Str.Process.Policy}"
                                                SelectedValueBinding="{Binding PolicyId, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="Id" DisplayMemberPath="Name"
                                                ItemsSource="{Binding DataContext.Policies,
                                                    RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Style="{StaticResource Subtle}" Margin="6,8"
                   TextWrapping="Wrap" Text="{DynamicResource Str.Process.LaunchHint}"/>

        <!-- ==== running processes ==== -->
        <Border Style="{StaticResource Card}" Grid.Row="2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Process.Applied}" Margin="0,0,0,6"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Refresh}" Command="{Binding RefreshAppliedCommand}" MinWidth="90"/>
                    <Button Content="{DynamicResource Str.Process.AddFromSelection}"
                            Command="{Binding AddRuleFromSelectionCommand}" Margin="8,0,0,0"/>
                    <Button Content="{DynamicResource Str.Process.Launch}"
                            Command="{Binding LaunchSuspendedCommand}" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Column headings for the tree below. They cannot line up with the deeper rows —
                     a child is indented, that is the point of a tree — so they label the roots. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,0,0,4">
                    <TextBlock Style="{StaticResource Subtle}" Width="64" Text="{DynamicResource Str.Process.Pid}"/>
                    <TextBlock Style="{StaticResource Subtle}" Width="190" Text="{DynamicResource Str.App.Name}"/>
                    <TextBlock Style="{StaticResource Subtle}" Width="150" Text="{DynamicResource Str.Process.Policy}"/>
                    <TextBlock Style="{StaticResource Subtle}" Text="{DynamicResource Str.Process.Path}"/>
                </StackPanel>

                <Grid>
                    <TreeView ItemsSource="{Binding AppliedProcesses}"
                              SelectedItemChanged="AppliedProcesses_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" Width="64"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding Name}" Width="190" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Policy}" Width="150"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border CornerRadius="8" Padding="7,1" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Accent.Subtle}"
                                            Visibility="{Binding IsChild, Converter={StaticResource TrueToVisible}}">
                                        <TextBlock Text="{DynamicResource Str.Process.Inherited}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Subtle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Margin="18,4,0,0" Text="{DynamicResource Str.Process.NoneApplied}"
                               VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppliedProcesses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
