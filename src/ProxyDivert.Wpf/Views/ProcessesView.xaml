<UserControl x:Class="ProxyDivert.Wpf.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProxyDivert.Wpf.Bindings">
    <!-- A DataGrid column is outside the visual tree, so the combo columns below reach the view
         model through this proxy instead of an ancestor lookup that cannot resolve. -->
    <UserControl.Resources>
        <b:BindingProxy x:Key="Vm" Data="{Binding}"/>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==== process rules ==== -->
        <Border Style="{StaticResource Card}" Grid.Row="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Process.Rules}" Margin="0,0,0,6"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Add}" Command="{Binding AddRuleCommand}" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Remove}" Command="{Binding RemoveRuleCommand}"
                            Margin="8,0,0,0" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="{b:LocalizedBinding Str.App.Enabled}"
                                                Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <!-- Kind and value are one condition, so they are one column: choosing
                             "full path" and then typing a bare name is a rule that silently never
                             matches, and two separate columns invite exactly that. -->
                        <DataGridTemplateColumn Header="{b:LocalizedBinding Str.Process.Target}" Width="*" MinWidth="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="165"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Data.Matchers, Source={StaticResource Vm}}"
                                                  SelectedItem="{Binding Matcher, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemTemplate="{StaticResource EnumItemTemplate}"/>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Tag="{b:LocalizedBinding Str.Process.TargetHint}"
                                                 Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- The same shape again, ANDed with the one above. Left empty it is not
                             consulted, so a rule written before this existed keeps its meaning. -->
                        <DataGridTemplateColumn Header="{b:LocalizedBinding Str.Process.Argument}" Width="*" MinWidth="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Data.ArgumentMatchers, Source={StaticResource Vm}}"
                                                  SelectedItem="{Binding ArgumentMatcher, UpdateSourceTrigger=PropertyChanged}"
                                                  ItemTemplate="{StaticResource EnumItemTemplate}"/>
                                        <TextBox Grid.Column="1" Margin="6,0,0,0"
                                                 Tag="{b:LocalizedBinding Str.Process.ArgumentHint}"
                                                 Text="{Binding ArgumentPattern, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="{b:LocalizedBinding Str.Process.IncludeChildren}"
                                                Binding="{Binding IncludeChildren, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridComboBoxColumn Header="{b:LocalizedBinding Str.Process.Policy}"
                                                SelectedValueBinding="{Binding PolicyId, UpdateSourceTrigger=PropertyChanged}"
                                                SelectedValuePath="Id" DisplayMemberPath="Name"
                                                ItemsSource="{Binding Data.Policies, Source={StaticResource Vm}}"
                                                Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Style="{StaticResource Subtle}" Margin="6,8"
                   TextWrapping="Wrap" Text="{DynamicResource Str.Process.LaunchHint}"/>

        <!-- ==== running processes ==== -->
        <Border Style="{StaticResource Card}" Grid.Row="2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Process.Applied}" Margin="0,0,0,6"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Refresh}" Command="{Binding RefreshAppliedCommand}" MinWidth="90"/>
                    <Button Content="{DynamicResource Str.Process.AddFromSelection}"
                            Command="{Binding AddRuleFromSelectionCommand}" Margin="8,0,0,0"/>
                    <Button Content="{DynamicResource Str.Process.Launch}"
                            Command="{Binding LaunchSuspendedCommand}" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Column headings for the tree below. They cannot line up with the deeper rows —
                     a child is indented, that is the point of a tree — so they label the roots. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,0,0,4">
                    <TextBlock Style="{StaticResource Subtle}" Width="64" Text="{DynamicResource Str.Process.Pid}"/>
                    <TextBlock Style="{StaticResource Subtle}" Width="190" Text="{DynamicResource Str.App.Name}"/>
                    <TextBlock Style="{StaticResource Subtle}" Width="150" Text="{DynamicResource Str.Process.Policy}"/>
                    <TextBlock Style="{StaticResource Subtle}" Text="{DynamicResource Str.Process.Path}"/>
                </StackPanel>

                <Grid>
                    <TreeView ItemsSource="{Binding AppliedProcesses}"
                              SelectedItemChanged="AppliedProcesses_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}" Width="64"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding Name}" Width="190" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Policy}" Width="150"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border CornerRadius="8" Padding="7,1" Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource Brush.Accent.Subtle}"
                                            Visibility="{Binding IsChild, Converter={StaticResource TrueToVisible}}">
                                        <TextBlock Text="{DynamicResource Str.Process.Inherited}" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Subtle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Margin="18,4,0,0" Text="{DynamicResource Str.Process.NoneApplied}"
                               VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppliedProcesses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
