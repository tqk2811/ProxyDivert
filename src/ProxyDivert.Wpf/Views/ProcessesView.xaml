<UserControl x:Class="ProxyDivert.Wpf.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="clr-namespace:ProxyDivert.Wpf.Bindings"
             xmlns:loc="clr-namespace:ProxyDivert.Wpf.Localization">
    <!-- A DataGrid column is outside the visual tree, so the combo columns below reach the view
         model through this proxy instead of an ancestor lookup that cannot resolve. -->
    <UserControl.Resources>
        <b:BindingProxy x:Key="Vm" Data="{Binding}"/>

        <!-- A grid row has no room for a line of its own, so the insertion mark is the row's own
             border: above it for "lands here", below it for "lands under this one". -->
        <Style x:Key="RuleRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="b:DragReorderBehavior.DropZone" Value="Row"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Value="Before"
                             Binding="{Binding (b:DragReorderBehavior.DropMark),
                                       RelativeSource={RelativeSource Self}}">
                    <Setter Property="BorderThickness" Value="0,2,0,0"/>
                </DataTrigger>
                <DataTrigger Value="After"
                             Binding="{Binding (b:DragReorderBehavior.DropMark),
                                       RelativeSource={RelativeSource Self}}">
                    <Setter Property="BorderThickness" Value="0,0,0,2"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ==== process rules ==== -->
        <Border Style="{StaticResource Card}" Grid.Row="0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Process.Rules}" Margin="0,0,0,2"/>

                <!-- Which filter catches a process is decided by this order, and nothing on screen
                     said so while there was no way to change it either. -->
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Subtle}" Margin="0,0,0,6"
                           TextWrapping="Wrap" Text="{DynamicResource Str.Process.RuleOrderHint}"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Add}" Command="{Binding AddRuleCommand}" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Remove}" Command="{Binding RemoveRuleCommand}"
                            Margin="8,0,0,0" MinWidth="80"/>
                    <Button Content="{DynamicResource Str.App.Save}" Command="{Binding SaveCommand}"
                            Style="{StaticResource AccentButton}" Margin="8,0,0,0" MinWidth="80"/>
                </StackPanel>

                <!-- Sorting is off on purpose. The row order IS the priority, so a column sort
                     would show one order while the engine matched another, and dragging a row in
                     a sorted grid would drop it somewhere else entirely. -->
                <DataGrid ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          CanUserSortColumns="False"
                          RowStyle="{StaticResource RuleRow}"
                          b:DragReorderBehavior.IsDropSurface="True"
                          b:DragReorderBehavior.DropList="{Binding}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="36" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DragGrip}" Margin="0"
                                               Padding="2,7" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="{b:LocalizedBinding Str.App.Enabled}"
                                                Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="{b:LocalizedBinding Str.App.Name}" Width="180"
                                            Binding="{Binding Name}"/>
                        <!-- A condition tree does not fit in a cell, so the cell shows what the
                             tree reads as and the button opens it. The sentence is rebuilt when
                             the language changes, which is what the second binding is for. -->
                        <DataGridTemplateColumn Header="{b:LocalizedBinding Str.Process.Conditions}" Width="*" MinWidth="320">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding Converter="{StaticResource ConditionSummary}" Mode="OneWay">
                                                    <Binding Path="Condition"/>
                                                    <Binding Path="Version" Source="{x:Static loc:LocalizationScope.Instance}"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Button Grid.Column="1" Margin="8,0,0,0" MinWidth="70"
                                                Content="{DynamicResource Str.Process.Edit}"
                                                Command="{Binding Data.EditRuleCommand, Source={StaticResource Vm}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridCheckBoxColumn Header="{b:LocalizedBinding Str.Process.IncludeChildren}"
                                                Binding="{Binding IncludeChildren, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <!-- The policies this filter applies, in the order their rules are tried.
                             Read-only here and arranged in the editor: the order is the meaning,
                             and a drop-down cannot say it. -->
                        <DataGridTemplateColumn Header="{b:LocalizedBinding Str.Process.Policies}" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap">
                                        <TextBlock.Text>
                                            <MultiBinding Converter="{StaticResource PolicyNames}" Mode="OneWay">
                                                <Binding Path="PolicyIds"/>
                                                <Binding Path="Data.Policies" Source="{StaticResource Vm}"/>
                                                <Binding Path="Version" Source="{x:Static loc:LocalizationScope.Instance}"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="1" Style="{StaticResource Subtle}" Margin="6,8"
                   TextWrapping="Wrap" Text="{DynamicResource Str.Process.LaunchHint}"/>

        <!-- ==== running processes ==== -->
        <Border Style="{StaticResource Card}" Grid.Row="2">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Heading}"
                           Text="{DynamicResource Str.Process.Applied}" Margin="0,0,0,6"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="{DynamicResource Str.App.Refresh}" Command="{Binding RefreshAppliedCommand}" MinWidth="90"/>
                    <Button Content="{DynamicResource Str.Process.AddFromSelection}"
                            Command="{Binding AddRuleFromSelectionCommand}" Margin="8,0,0,0"/>
                    <Button Content="{DynamicResource Str.Process.Launch}"
                            Command="{Binding LaunchSuspendedCommand}" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Column headings for the tree below. They cannot line up with the deeper rows —
                     a child is indented, that is the point of a tree — so they label the roots.
                     They are not buttons and nothing sorts on a click: the tree stands in one
                     order, parents with their children under them, and sorting it by a column
                     would take that apart.

                     The widths live on the view model, and the rows below bind to the same three
                     numbers. That is what carries a splitter drag down into the rows — a tree has
                     no columns of its own to widen. -->
                <Grid DockPanel.Dock="Top" Margin="18,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="40"
                                          Width="{Binding AppliedPidWidth, Mode=TwoWay,
                                                  Converter={StaticResource PixelWidth}}"/>
                        <ColumnDefinition MinWidth="60"
                                          Width="{Binding AppliedNameWidth, Mode=TwoWay,
                                                  Converter={StaticResource PixelWidth}}"/>
                        <ColumnDefinition MinWidth="60"
                                          Width="{Binding AppliedFilterWidth, Mode=TwoWay,
                                                  Converter={StaticResource PixelWidth}}"/>
                        <ColumnDefinition MinWidth="60"
                                          Width="{Binding AppliedPathWidth, Mode=TwoWay,
                                                  Converter={StaticResource PixelWidth}}"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Style="{StaticResource Subtle}"
                               Text="{DynamicResource Str.Process.Pid}"/>
                    <TextBlock Grid.Column="1" Style="{StaticResource Subtle}"
                               Text="{DynamicResource Str.App.Name}"/>
                    <TextBlock Grid.Column="2" Style="{StaticResource Subtle}"
                               Text="{DynamicResource Str.Process.MatchedFilter}"/>
                    <TextBlock Grid.Column="3" Style="{StaticResource Subtle}"
                               Text="{DynamicResource Str.Process.Path}"/>
                    <TextBlock Grid.Column="4" Style="{StaticResource Subtle}"
                               Text="{DynamicResource Str.Process.Arguments}"/>

                    <!-- Invisible, and hanging off the right edge of the column it widens: a
                         visible bar between two headings would read as a border. -->
                    <GridSplitter Grid.Column="0" Style="{StaticResource ColumnSplitter}"/>
                    <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>
                    <GridSplitter Grid.Column="2" Style="{StaticResource ColumnSplitter}"/>
                    <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>
                </Grid>

                <Grid>
                    <TreeView ItemsSource="{Binding AppliedProcesses}"
                              SelectedItemChanged="AppliedProcesses_SelectedItemChanged">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <!-- The widths come from the same three numbers the headings use,
                                     through the proxy: a row is drawn by this template, and inside
                                     one there is no ancestor to reach the view model by. -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Id}"
                                               Width="{Binding Data.AppliedPidWidth, Source={StaticResource Vm}}"
                                               Foreground="{DynamicResource Brush.Text.Secondary}"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Width="{Binding Data.AppliedNameWidth, Source={StaticResource Vm}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}"/>

                                    <!-- Which filter caught this process, rather than which policies
                                         that filter routes it by: the policies belong to the filter
                                         and are listed against it in the grid above, while the
                                         filter is the thing to go and edit. An adopted child shows
                                         its parent's, because that is the one that caught it — and
                                         it sits under that parent in the tree, which says as much
                                         without a badge. -->
                                    <TextBlock Text="{Binding Filter}"
                                               Width="{Binding Data.AppliedFilterWidth, Source={StaticResource Vm}}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Filter}"/>

                                    <TextBlock Text="{Binding Path}" Style="{StaticResource Subtle}"
                                               Width="{Binding Data.AppliedPathWidth, Source={StaticResource Vm}}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Path}"/>

                                    <!-- What the process was started with, minus the executable
                                         the column beside this one already shows. The tooltip
                                         gives the whole command line back, because that — not
                                         this trimmed tail — is the text an Argument condition is
                                         matched against. -->
                                    <TextBlock Text="{Binding Arguments}" Style="{StaticResource Subtle}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CommandLine}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>

                    <TextBlock Margin="18,4,0,0" Text="{DynamicResource Str.Process.NoneApplied}"
                               VerticalAlignment="Top" HorizontalAlignment="Left">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Subtle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AppliedProcesses.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
