<Application x:Class="ProxyDivert.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProxyDivert.Wpf.Converters"
             xmlns:loc="clr-namespace:ProxyDivert.Wpf.Localization">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette first: ThemeManager swaps THIS dictionary at runtime, and every style
                     below references its brushes via DynamicResource so the swap is live. -->
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Localization/Strings.en.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Themes/Controls.ListBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:FalseToVisibleConverter x:Key="FalseToVisible"/>
            <conv:TrueToVisibleConverter x:Key="TrueToVisible"/>
            <conv:ByteSizeConverter x:Key="ByteSize"/>
            <conv:DurationConverter x:Key="Duration"/>
            <conv:IsNullOrEmptyConverter x:Key="IsNullOrEmpty"/>
            <conv:EnumLocalizeConverter x:Key="EnumText"/>
            <conv:AppLanguageDisplayConverter x:Key="AppLanguageText"/>
            <conv:ConditionSummaryConverter x:Key="ConditionSummary"/>
            <conv:PolicyNamesConverter x:Key="PolicyNames"/>
            <conv:SameObjectConverter x:Key="SameObject"/>
            <conv:ConditionResultBrushConverter x:Key="ConditionResultBrush"/>

            <!-- Every list of enum values in the app shows its items through these. The templates
                 are for a stand-alone ComboBox; the style is for a DataGridComboBoxColumn, which
                 builds its own ComboBox and so can only be reached through ElementStyle /
                 EditingElementStyle.

                 The second binding is LocalizationScope.Version, which changes with the language
                 and so re-runs the converter — a converter's output, unlike a DynamicResource, has
                 nothing to re-read on its own. -->
            <DataTemplate x:Key="EnumItemTemplate">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource EnumText}" Mode="OneWay">
                            <Binding/>
                            <Binding Path="Version" Source="{x:Static loc:LocalizationScope.Instance}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>

            <DataTemplate x:Key="LanguageItemTemplate">
                <TextBlock>
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource AppLanguageText}" Mode="OneWay">
                            <Binding/>
                            <Binding Path="Version" Source="{x:Static loc:LocalizationScope.Instance}"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </DataTemplate>

            <Style x:Key="EnumComboColumn" TargetType="ComboBox"
                   BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="ItemTemplate" Value="{StaticResource EnumItemTemplate}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
