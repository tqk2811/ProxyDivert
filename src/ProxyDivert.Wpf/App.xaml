<Application x:Class="ProxyDivert.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ProxyDivert.Wpf.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Palette first: ThemeManager swaps THIS dictionary at runtime, and every style
                     below references its brushes via DynamicResource so the swap is live. -->
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Themes/Colors.Dark.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Localization/Strings.en.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Themes/Controls.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/ProxyDivert;component/Themes/Controls.ListBox.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:FalseToVisibleConverter x:Key="FalseToVisible"/>
            <conv:TrueToVisibleConverter x:Key="TrueToVisible"/>
            <conv:ByteSizeConverter x:Key="ByteSize"/>
            <conv:DurationConverter x:Key="Duration"/>
            <conv:IsNullOrEmptyConverter x:Key="IsNullOrEmpty"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
