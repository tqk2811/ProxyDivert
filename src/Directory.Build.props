<Project>
	<!--
		Chỉ áp cho project của tool (nằm dưới src/). KHÔNG đặt file này ở gốc repo:
		libs/TqkLibrary.* không có Directory.Build.props riêng nên file ở gốc sẽ lan sang chúng.
	-->
	<PropertyGroup>
		<LangVersion>12.0</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<PathMap>$(MSBuildProjectDirectory)=$(MSBuildProjectName)</PathMap>
		<Platforms>x64</Platforms>
		<PlatformTarget>x64</PlatformTarget>
		<Company>tqk2811</Company>
		<Product>ProxyDivert</Product>
		<!-- Local API + MCP compiled into the app (see src/ProxyDivert/ProxyDivert.csproj);
		     -p:EnableLocalApi=false gives the "lite" build. Defined here so the tests follow it. -->
		<EnableLocalApi Condition="'$(EnableLocalApi)' == ''">true</EnableLocalApi>
		<DefineConstants Condition="'$(EnableLocalApi)' == 'true'">$(DefineConstants);LOCAL_API</DefineConstants>
	</PropertyGroup>
</Project>
